# ==========================================================
# APLIKASI
# ==========================================================
NODE_ENV=development
PORT=3000
APP_NAME="Kantin POS"
APP_TIMEZONE=Asia/Jakarta

# ==========================================================
# DATABASE (PostgreSQL)
# DATABASE_URL      -> dipakai saat runtime (dev/produksi)
# TEST_DATABASE_URL -> dipakai HANYA saat NODE_ENV=test (Jest)
# ==========================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_kantin_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_kantin_test

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false

# ==========================================================
# IDENTITAS TOKO (dipakai pada header struk PDF)
# ==========================================================
STORE_NAME="Kantin Sejahtera"
STORE_ADDRESS="Jl. Contoh Raya No. 1, Jakarta"
STORE_PHONE="021-0000000"
RECEIPT_FOOTER="Terima kasih atas kunjungan Anda"

# Lebar kertas thermal 80mm dalam satuan point (80mm / 25.4 * 72 = 226.77)
RECEIPT_PAPER_WIDTH=226.77
