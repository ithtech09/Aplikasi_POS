{
  "name": "express-pos-kantin",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi Manajemen Menu & POS (Point of Sale) Kantin - Express + TypeScript + PostgreSQL + EJS + Tailwind CSS v4",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:debug": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --verbose",
    "css:build": "tailwindcss -i ./src/input.css -o ./public/css/output.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "db:migrate": "psql \"$DATABASE_URL\" -f database/schema.sql",
    "db:migrate:win": "psql $env:DATABASE_URL -f database/schema.sql"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
