<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> &middot; <%= appName %></title>
  <link rel="stylesheet" href="/public/css/output.css" />
</head>
<body class="min-h-full bg-slate-900 text-slate-100">

  <header class="border-b border-slate-700/60 bg-slate-800/80">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-3">

      <a href="/pos" class="flex items-center gap-2">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-600 text-sm font-bold text-white">K</span>
        <span class="text-sm font-semibold tracking-tight text-slate-100"><%= appName %></span>
      </a>

      <nav class="flex items-center gap-1">
        <%
          const navItems = [
            { key: 'pos', href: '/pos', label: 'Kasir' },
            { key: 'admin', href: '/admin', label: 'Admin' },
            { key: 'reports', href: '/admin/reports/daily', label: 'Laporan' }
          ];
        %>
        <% navItems.forEach(function (item) { %>
          <a href="<%= item.href %>"
             class="rounded-lg px-3 py-1.5 text-sm font-medium transition-colors <%= activeNav === item.key
               ? 'bg-emerald-600 text-white'
               : 'text-slate-400 hover:bg-slate-700/60 hover:text-slate-100' %>">
            <%= item.label %>
          </a>
        <% }); %>
      </nav>

    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-6">
